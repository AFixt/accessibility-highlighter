# Engine strictness — refuse to install if Node doesn't match package.json engines
engine-strict=true

# Performance optimizations
progress=false
audit=false
fund=false

# Install optimizations
prefer-offline=true
cache-min=3600

# CI optimizations
loglevel=error
@afixt:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
