{
  "name": "@afixt/a11y-highlighter",
  "version": "1.0.5",
  "description": "The Accessibility Highlighter finds accessibility problems on a website and highlights them on the page to give a visual indication of what the problems are. It also logs errors to console and annotates the DOM.",
  "main": "src/background.js",
  "scripts": {
    "clean": "rm -rf dist coverage a11y-highlighter.zip reports",
    "test": "jest --maxWorkers=50%",
    "test:watch": "jest --watch --maxWorkers=25%",
    "test:coverage": "jest --coverage --maxWorkers=50%",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm-run-all --parallel lint:check test test:e2e",
    "lint": "eslint src/ tests/ scripts/ *.js",
    "lint:fix": "eslint src/ tests/ scripts/ *.js --fix",
    "lint:check": "eslint src/ tests/ scripts/ *.js --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore coverage --ignore reports --ignore scratchpads --ignore docs/templates --ignore errors.md --ignore element-highlighting-guide.md --ignore CHANGELOG.md --ignore CLAUDE.md",
    "lint:cpd": "jscpd . --config .jscpd.json",
    "lint:cpd:ci": "jscpd . --config .jscpd.json --threshold 5",
    "security:audit": "npm audit",
    "security:check": "npm audit --audit-level=high",
    "version:sync": "node scripts/manifest-version.js --write",
    "version:check": "node scripts/manifest-version.js --check",
    "size": "size-limit",
    "license:check": "license-checker-rseidelsohn --production --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;CC0-1.0;Unlicense;Python-2.0;WTFPL;BlueOak-1.0.0' --excludePrivatePackages --summary",
    "license:report": "license-checker-rseidelsohn --production --csv --out reports/licenses.csv",
    "links": "command -v lychee >/dev/null 2>&1 && lychee --no-progress '**/*.md' || echo 'lychee not installed; skipping link check (see scripts/bootstrap.sh)'",
    "check": "npm-run-all --parallel lint:check format:check lint:md version:check",
    "check:all": "npm-run-all -s check test build size license:check links security:check",
    "prebuild": "npm run clean",
    "build": "mkdir -p dist && cp -r src/* manifest.json dist/",
    "build:all": "node scripts/build.js all",
    "build:chrome": "node scripts/build.js chrome",
    "build:firefox": "node scripts/build.js firefox",
    "build:edge": "node scripts/build.js edge",
    "package": "npm run build && cd dist && zip -r ../a11y-highlighter.zip *",
    "dev": "npm run build && npm run test:watch",
    "prepare": "husky",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "release:first": "standard-version --first-release",
    "release:dry-run": "standard-version --dry-run",
    "version": "npm run version:sync && git add manifest.json"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "chrome-extension"
  ],
  "author": "AFixt <talktous@afixt.com>",
  "homepage": "https://github.com/AFixt/a11y-highlighter",
  "repository": {
    "type": "git",
    "url": "https://github.com/AFixt/a11y-highlighter"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@size-limit/file": "^12.1.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jscpd": "^4.0.5",
    "license-checker-rseidelsohn": "^4.4.2",
    "lint-staged": "^17.0.4",
    "markdownlint-cli": "^0.49.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.1",
    "size-limit": "^12.1.0",
    "standard-version": "^9.5.0"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "^1.1.16"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "size-limit": [
    {
      "name": "contentScript (brotli)",
      "path": "src/contentScript.js",
      "limit": "30 KB"
    },
    {
      "name": "background (brotli)",
      "path": "src/background.js",
      "limit": "5 KB"
    },
    {
      "name": "config (brotli)",
      "path": "src/config.js",
      "limit": "5 KB"
    }
  ]
}
